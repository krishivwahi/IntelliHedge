# Alpaca Paper Trading credentials
# Copy this file to .env and fill in your credentials locally.
APCA_API_KEY_ID=your_alpaca_key_id_here
APCA_API_SECRET_KEY=your_alpaca_secret_here

# Direct Benzinga API token (requires a separate licence/contract).
# Not currently consumed by the Alpaca collector.
BENZINGA_API_TOKEN=your_benzinga_token_here
